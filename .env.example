EMAIL_LOG_PAGE_SIZE=
# Working days a finding gets when no target date is given. Defaults to 7.
FINDING_DUE_WORKING_DAYS=
# Largest evidence photo accepted, in MB (max 6). Defaults to 5.
MAX_UPLOAD_MB=
# Days a signed-in session stays valid. Defaults to 7.
SESSION_MAX_AGE_DAYS=
